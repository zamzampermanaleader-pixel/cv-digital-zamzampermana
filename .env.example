
APP_NAME="CV Digital Zamzam"
APP_ENV=local
APP_KEY=base64:nrcyCgQ2CKBidLxnLxAsvRQFTrq+kCh47jGvWeaWC4M=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_cv
DB_USERNAME=root
DB_PASSWORD=

# Vercel + Filess.io MySQL (copy to Vercel Environment Variables)
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://<your-vercel-domain>
# LOG_CHANNEL=stderr
# DB_CONNECTION=mysql
# DB_HOST=<host-from-filess-dashboard>
# DB_PORT=<port-from-filess-dashboard>
# DB_DATABASE=<filess-database-name>
# DB_USERNAME=<filess-database-username>
# DB_PASSWORD=<filess-database-password>
# MYSQL_ATTR_SSL_CA=<ca-certificate-path-if-provided-by-filess>
# SESSION_DRIVER=database
# CACHE_STORE=database
# QUEUE_CONNECTION=sync

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@cvdigital.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
